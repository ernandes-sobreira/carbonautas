# Arquivo final: /etc/carbonautas-backup.env, root:root, chmod 600.
GOOGLE_APPLICATION_CREDENTIALS=/opt/carbonautas-bridge/firebase-service-account.json
CARBONAUTAS_BRIDGE_DIR=/opt/carbonautas-bridge
# Preencher com seu destino externo privado. Não usar o repositório GitHub.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/carbonautas-backup-password
# Acrescentar credenciais do destino apenas neste arquivo privado, se necessárias.
